{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swarm-coach",
  "compatibility_date": "2026-10-23",
  "routes": [
    {
      "pattern": "swarm.coach",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
